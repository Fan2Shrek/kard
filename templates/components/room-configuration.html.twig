<div id="room-configuration" class="room-configuration black-card">
    <h2><twig:UX:Icon name="lucide:settings-2" /> Configuration</h2>
    {% if (editable is defined ? editable : (room.owner == app.user)) %}
        <form method="POST" action="{{ path('game_configuration', {id: room.id}) }}" class="room-configuration__form">
            <twig:ui:Toggle
                name="withJokers"
                label="Inclure les jokers"
                icon="lucide:sparkles"
                :checked="configuration.hasJokers"
            />
            <twig:ui:NumberField
                name="deckCount"
                label="Nombre de decks"
                icon="lucide:layers"
                min="1"
                max="{{ constant('App\\Game\\Builder\\GameConfigurationBuilder::MAX_DECK_COUNT') }}"
                value="{{ configuration.deckCount }}"
            />
            <twig:ui:SelectField
                name="skin"
                label="Skin des cartes"
                icon="lucide:image"
                :choices="skins|reduce((acc, skin) => acc|merge({(skin.value|capitalize): skin.value}), {})"
                value="{{ configuration.getSkin.value }}"
            />
            {% if room.gameMode.value.value == 'crazy_eights' %}
                <twig:ui:Toggle
                    name="stackTwos"
                    label="Empiler les 2"
                    icon="lucide:layers-3"
                    :checked="configuration.get('stackTwos')"
                />
            {% endif %}
            <twig:Button
                type="submit"
                text="Mettre à jour"
                iconLeft="lucide:save"
            />
        </form>
    {% else %}
        <ul class="room-configuration__list">
            <li>
                <twig:UX:Icon name="lucide:sparkles" />
                Jokers
                <strong>{{ configuration.hasJokers ? 'Oui' : 'Non' }}</strong>
            </li>
            <li>
                <twig:UX:Icon name="lucide:layers" />
                Decks
                <strong>{{ configuration.deckCount }}</strong>
            </li>
            <li>
                <twig:UX:Icon name="lucide:image" />
                Skin
                <strong>{{ configuration.getSkin.value|capitalize }}</strong>
            </li>
            {% if room.gameMode.value.value == 'crazy_eights' %}
                <li>
                    <twig:UX:Icon name="lucide:layers-3" />
                    Empiler les 2
                    <strong>{{ configuration.get('stackTwos') ? 'Oui' : 'Non' }}</strong>
                </li>
            {% endif %}
        </ul>
    {% endif %}
</div>
