{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <main class="login bg-card-image">
        <twig:FloatingBackground />

        <twig:BlackCard>
            <twig:ColorsHeader />
            <h2>Connexion</h2>

            {% if error %}
                <div class="alert">
                    <twig:UX:Icon name="ri:error-warning-line" />
                    <p>Identifiants incorrects. Veuillez vérifier vos nom d'utilisateur et mot de passe.</p>
                </div>
            {% endif %}

            <form method="post" id="login-form">
                <twig:ui:InputField
                    id="username"
                    label="Nom d'utilisateur"
                    icon="lucide:user"
                    type="text"
                    name="_username"
                    value="{{ last_username }}"
                    placeholder="Votre pseudo"
                    autocomplete="username"
                    required
                    autofocus
                />
                <twig:ui:InputField
                    id="password"
                    label="Mot de passe"
                    icon="lucide:lock"
                    type="password"
                    name="_password"
                    placeholder="••••••••"
                    autocomplete="current-password"
                    required
                />
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            </form>

            <twig:Button
                type="submit"
                form="login-form"
                text="Se connecter"
                iconLeft="lucide:log-in"
                variant="success"
            />
            <twig:Button
                :href="path('app_register')"
                text="S'inscrire"
                iconLeft="lucide:user-plus"
                variant="default"
            />
        </twig:BlackCard>
    </main>
{% endblock %}
