{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <main class="login bg-card-image">
        <twig:FloatingBackground />

        <twig:BlackCard>
            <twig:ColorsHeader />
            <h2>Créer un compte</h2>

            {% if form_errors(registrationForm) %}
                <div class="alert">
                    <twig:UX:Icon name="ri:error-warning-line" />
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}

            {{ form_start(registrationForm, {attr: {id: 'registration-form'}}) }}
            <twig:ui:InputField
                :field="registrationForm.username"
                label="Nom d'utilisateur"
                icon="lucide:user"
                :widget="{attr: {placeholder: 'Votre pseudo', autocomplete: 'username'}}"
            />

            <twig:ui:InputField
                :field="registrationForm.plainPassword"
                label="Mot de passe"
                icon="lucide:lock"
                :widget="{attr: {placeholder: '••••••••', autocomplete: 'new-password'}}"
            />
            {{ form_end(registrationForm) }}

            <twig:Button
                    type="submit"
                    form="registration-form"
                    text="Créer mon compte"
                    iconLeft="lucide:user-plus"
                    variant="success"
            />
        </twig:BlackCard>
    </main>
{% endblock %}
